# ─────────────────────────────────────────────────────────────
# Orion Builders CRM/ERP — Environment variables
# এই ফাইলটি `.env` নামে কপি করে নিজের ভ্যালু বসান:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Local:    postgresql://USER:PASSWORD@localhost:5432/orion_crm?schema=public
# Neon:     postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/orion_crm?sslmode=require
# Supabase: postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orion_crm?schema=public"

# NextAuth — সেশন JWT সাইন করার সিক্রেট
# জেনারেট করুন:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# অ্যাপের public URL (dev এ localhost, প্রোডাকশনে আসল ডোমেইন)
NEXTAUTH_URL="http://localhost:3000"

# Seed script এ তৈরি হওয়া ডেমো অ্যাকাউন্টগুলোর পাসওয়ার্ড (optional)
SEED_PASSWORD="Orion@1234"

# ওভারডিউ ডিটেকশন cron (`/api/cron/overdue`) এর বেয়ারার টোকেন — PRD সেকশন ৫.৩
# জেনারেট করুন:  openssl rand -base64 32
# প্রোডাকশনে অবশ্যই সেট করুন; না দিলে রুটটি শুধু dev এ খোলা থাকে
CRON_SECRET=""

# ─────────────────────────────────────────────────────────────
# Email / SMS নোটিফিকেশন চ্যানেল — PRD সেকশন ৫.৬
# কোনোটাই সেট না করলে শুধু ইন-অ্যাপ নোটিফিকেশন যাবে; ডেলিভারিগুলো
# `SKIPPED` লেখা থাকবে আর dev এ কনসোলে ছাপা হবে (কিছু ভাঙবে না)।
# ─────────────────────────────────────────────────────────────

# Email — Resend (https://resend.com) এর HTTP API
RESEND_API_KEY=""
EMAIL_FROM="Orion Builders <no-reply@orionbuilders.com>"

# SMS — গেটওয়ে-নিরপেক্ষ URL টেমপ্লেট। প্লেসহোল্ডার: {key} {to} {msg} {sender}
# (মানগুলো URL-encode হয়ে বসে)। বাংলাদেশি প্রায় সব গেটওয়েই এই আকারের API দেয়:
#   SMS_API_URL="https://api.example-bd.com/sendsms?api_key={key}&to={to}&msg={msg}&sender_id={sender}"
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID=""
# GET (ডিফল্ট) না POST — POST হলে টেমপ্লেটের query অংশটাই form body হয়ে যায়
SMS_API_METHOD="GET"
