// Orion Builders CRM/ERP — Prisma Schema (v2)
// v2 change: removed multi-unit "Project→Unit→Sale" (real-estate developer model);
// replaced with direct "Lead→Project" (one client = one construction job).
// Added: LeadChecklistItem, LedgerEntry (client-wise + company-wide accounting),
// BuildingType, ServiceCategory, Project.cameraStreamUrl, Installment.phaseId link.
//
// Run: npx prisma migrate dev --name business-model-v2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MARKETING
  ENGINEER
  ACCOUNTS
  CUSTOMER
}

enum LeadStage {
  INQUIRY
  DISCUSSION
  SITE_VISIT_SCHEDULED
  SITE_VISIT_DONE
  DIGITAL_SURVEY
  SOIL_TEST
  DESIGN_IN_PROGRESS
  DESIGN_APPROVED
  QUOTATION_SENT
  GOVT_APPROVAL
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  FACEBOOK_ADS
  WEBSITE
  WALK_IN
  REFERRAL
  COLD_CALL
  EXHIBITION
  OTHER
}

enum BuildingType {
  DUPLEX
  ONE_STORY
  TWO_STORY
  THREE_STORY
  FOUR_STORY
  FIVE_PLUS_STORY
  OTHER
}

enum ChecklistStatus {
  PENDING
  DONE
}

enum LeadFileType {
  FLOOR_PLAN
  THREE_D_DESIGN
  PROPOSAL
  LAND_DOCUMENT
  OTHER
}

enum InstallmentStatus {
  SCHEDULED
  PAID
  PARTIAL
  OVERDUE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  BKASH
  NAGAD
  CHEQUE
  OTHER
}

enum PhaseStatus {
  UPCOMING
  IN_PROGRESS
  DONE
  DELAYED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

// LedgerEntry এর category — pre-project service ও general expense/income উভয়ের জন্য
enum LedgerCategory {
  SITE_VISIT
  DIGITAL_SURVEY
  SOIL_TEST
  DESIGN
  GOVT_APPROVAL
  CONSTRUCTION_INSTALLMENT
  MATERIAL_COST
  LABOR_COST
  OFFICE_OVERHEAD
  OTHER
}

enum LedgerType {
  INCOME
  EXPENSE
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  phone         String?
  passwordHash  String
  role          Role
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  assignedLeads         Lead[]          @relation("AssignedLeads")
  uploadedLeadDocuments LeadDocument[]  @relation("LeadDocumentUploader")
  checklistUpdates      LeadChecklistItem[] @relation("ChecklistDoneBy")
  ledgerEntries         LedgerEntry[]   @relation("LedgerCreatedBy")
  phaseUpdates          PhaseUpdate[]
  payments              Payment[]       @relation("ReceivedByUser")
  customer              Customer?
  notifications         Notification[]
  activityLogs          ActivityLog[]
}

model Lead {
  id                   String       @id @default(cuid())
  name                 String
  phone                String       // international format সহ, e.g. +971-50-XXXXXXX
  residenceCountry     String?      // প্রবাসী হলে বর্তমানে যে দেশে থাকে
  email                String?
  source               LeadSource
  projectLocation      String?      // ক্লায়েন্টের জমির প্রকৃত অবস্থান
  landSize             String?      // e.g. "৪ কাঠা" — free text, unit বাংলাদেশে বিভিন্ন হতে পারে
  buildingType         BuildingType?
  budgetMin            Decimal?
  budgetMax            Decimal?
  stage                LeadStage    @default(INQUIRY)
  lostReason           String?
  assignedTo           User?        @relation("AssignedLeads", fields: [assignedToId], references: [id])
  assignedToId         String?
  nextFollowUpAt       DateTime?
  // প্রবাসী ক্লায়েন্টের বাংলাদেশে থাকা লোকাল কন্টাক্ট
  localContactName     String?
  localContactPhone    String?
  localContactRelation String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  activities   LeadActivity[]
  documents    LeadDocument[]
  checklist    LeadChecklistItem[]
  ledgerEntries LedgerEntry[]
  project      Project?
}

model LeadChecklistItem {
  id          String          @id @default(cuid())
  lead        Lead            @relation(fields: [leadId], references: [id])
  leadId      String
  label       String          // e.g. "সাইট ভিজিট সম্পন্ন", "সয়েল টেস্ট রিপোর্ট পাওয়া গেছে"
  status      ChecklistStatus @default(PENDING)
  note        String?
  doneBy      User?           @relation("ChecklistDoneBy", fields: [doneById], references: [id])
  doneById    String?
  doneAt      DateTime?
  createdAt   DateTime        @default(now())
}

model LeadDocument {
  id           String       @id @default(cuid())
  lead         Lead         @relation(fields: [leadId], references: [id])
  leadId       String
  fileUrl      String
  fileName     String
  fileType     LeadFileType @default(OTHER)
  description  String?
  uploadedBy   User         @relation("LeadDocumentUploader", fields: [uploadedById], references: [id])
  uploadedById String
  uploadedAt   DateTime     @default(now())
}

model LeadActivity {
  id        String   @id @default(cuid())
  lead      Lead     @relation(fields: [leadId], references: [id])
  leadId    String
  note      String
  createdAt DateTime @default(now())
}

// ── Accounts / Ledger ─────────────────────────────────────────────
// একটাই মডেল দুই কাজে ব্যবহার হয়:
//  ১. leadId সেট থাকলে → client-wise entry (Lead detail/Project profile এ দেখা যাবে)
//     - type=INCOME, clientVisible=true  → client portal এ বিল/রিসিট হিসেবে দেখাবে
//     - type=EXPENSE                      → শুধু Admin/Accounts দেখবে, clientVisible সবসময় false
//  ২. leadId null → company-wide general entry (office rent, salary ইত্যাদি), leadId ছাড়া
//     কখনো client portal এ দেখানো হবে না
model LedgerEntry {
  id            String         @id @default(cuid())
  lead          Lead?          @relation(fields: [leadId], references: [id])
  leadId        String?
  type          LedgerType
  category      LedgerCategory @default(OTHER)
  amount        Decimal
  date          DateTime       @default(now())
  note          String?
  receiptNo     String?        @unique // শুধু client-facing income entry তে থাকবে
  whatsappSentAt DateTime?
  clientVisible Boolean        @default(false) // EXPENSE এ কখনো true করা যাবে না — app-level ভ্যালিডেশনে enforce করতে হবে
  createdBy     User           @relation("LedgerCreatedBy", fields: [createdById], references: [id])
  createdById   String
  createdAt     DateTime       @default(now())
}

model Customer {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  nid       String?
  address   String?
  createdAt DateTime @default(now())

  projects  Project[]
}

// এক ক্লায়েন্ট = এক কনস্ট্রাকশন জব (আগের multi-unit "Sale" মডেলের বদলে)
model Project {
  id                 String        @id @default(cuid())
  lead               Lead          @relation(fields: [leadId], references: [id])
  leadId             String        @unique
  customer           Customer      @relation(fields: [customerId], references: [id])
  customerId         String
  title              String        // e.g. "রহিম সাহেবের ডুপ্লেক্স — সোনাডাঙ্গা"
  landLocation       String?
  buildingType       BuildingType?
  floors             Int?
  totalSqft          Decimal?
  ratePerSqft        Decimal?
  totalContractValue Decimal
  startDate          DateTime?
  cameraStreamUrl    String?       // লাইভ CC ক্যামেরা — admin manually বসাবে (embed/HLS URL)
  status             ProjectStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())

  paymentPlan   PaymentPlan?
  phases        Phase[]
  documents     Document[]
}

model PaymentPlan {
  id            String        @id @default(cuid())
  project       Project       @relation(fields: [projectId], references: [id])
  projectId     String        @unique
  createdAt     DateTime      @default(now())

  installments  Installment[]
}

model Installment {
  id             String             @id @default(cuid())
  paymentPlan    PaymentPlan        @relation(fields: [paymentPlanId], references: [id])
  paymentPlanId  String
  phase          Phase?             @relation(fields: [phaseId], references: [id]) // ঐচ্ছিক — কোন ফেজ শেষ হলে এই কিস্তি দিতে হবে
  phaseId        String?
  label          String             // e.g. "Signup Money", "Foundation Complete"
  dueDate        DateTime
  amount         Decimal
  status         InstallmentStatus  @default(SCHEDULED)

  payments       Payment[]
}

model Payment {
  id             String        @id @default(cuid())
  installment    Installment   @relation(fields: [installmentId], references: [id])
  installmentId  String
  amountReceived Decimal
  method         PaymentMethod
  receiptNo      String        @unique
  receivedBy     User          @relation("ReceivedByUser", fields: [receivedById], references: [id])
  receivedById   String
  paidAt         DateTime      @default(now())
}

// গ্লোবাল রিইউজেবল phase টেমপ্লেট (নির্দিষ্ট কোনো প্রজেক্টের সাথে বাঁধা না — Project তৈরি
// হওয়ার সময় এই টেমপ্লেট থেকে কপি করে সেই Project এর জন্য Phase রেকর্ড তৈরি হবে)
model PhaseTemplate {
  id                  String @id @default(cuid())
  name                String // e.g. "Foundation Work"
  order               Int
  defaultDurationDays Int?
}

model Phase {
  id              String      @id @default(cuid())
  project         Project     @relation(fields: [projectId], references: [id])
  projectId       String
  name            String
  order           Int
  status          PhaseStatus @default(UPCOMING)
  plannedStart    DateTime?
  plannedEnd      DateTime?
  actualStart     DateTime?
  actualEnd       DateTime?
  percentComplete Int         @default(0)

  updates       PhaseUpdate[]
  installments  Installment[]
}

model PhaseUpdate {
  id          String   @id @default(cuid())
  phase       Phase    @relation(fields: [phaseId], references: [id])
  phaseId     String
  updatedBy   User     @relation(fields: [updatedById], references: [id])
  updatedById String
  note        String?
  photoUrls   String[]
  createdAt   DateTime @default(now())
}

model Document {
  id         String   @id @default(cuid())
  project    Project? @relation(fields: [projectId], references: [id])
  projectId  String?
  type       String   // e.g. "Contract", "Govt Approval Copy", "Receipt", "Handover Certificate"
  fileUrl    String
  uploadedAt DateTime @default(now())
}

model Notification {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  type       String   // e.g. "PAYMENT_DUE", "PHASE_MILESTONE", "FOLLOW_UP_DUE"
  message    String
  readStatus Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  entityType String   // e.g. "Lead", "Payment", "Phase", "LedgerEntry"
  entityId   String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  action     String   // e.g. "STAGE_CHANGED", "PAYMENT_RECEIVED"
  metadata   Json?
  createdAt  DateTime @default(now())
}
